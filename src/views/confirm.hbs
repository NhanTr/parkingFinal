<link rel="stylesheet" href="/css/confirm.css">
<div id="confirm-screen" class="screen active">
  <div class="card confirm-card">
    <img src="img/logo.png" alt="logo">
    <p>Smart parking system</p>

    <div class="content">
      <h2> Vé đặt chỗ </h2>
      <h3>Mã vào là: {{bookingCode}}</h3>
      <p>Khách hàng: {{user.fullname}}</p>
      <p><img src="img/rho.png" alt=""><strong>Bãi đỗ xe RL</strong></p>
      <p><img src="img/location.png" alt="">97 Man Thiện, TP. Thủ Đức</p>
      {{!-- <div class="payment-section">
      <button id="start-payment-btn" class="button">Bắt đầu tính tiền</button>
        <div id="payment-info" style="margin-top:10px; display:none;">
          <p>Thời gian bắt đầu: <span id="start-time"></span></p>
          <p>Thời gian hiện tại: <span id="current-time"></span></p>
          <p>Tổng thời gian: <span id="elapsed-time"></span></p>
          <p>Tiền cần thanh toán: <span id="total-amount"></span> VNĐ</p>
        </div>
      </div> --}}
      <!-- Thêm div nhập ghi chú -->
      <div class="note-section">
        <label for="noteInput"><strong>Ghi chú cho vé này:</strong></label>
        <textarea id="noteInput" rows="3" placeholder="Nhập ghi chú..."></textarea>
        <button id="saveNoteBtn" class="button" style="margin-top:8px;">Lưu ghi chú</button>
        <div id="noteStatus" style="margin-top:6px;font-size:14px;"></div>
      </div>

      <div class="note">  
        <p> - Chụp ảnh màn hình để xác nhận với nhà xe.</p>
        <p> - Nếu đến trễ hơn 30 phút, hệ thống sẽ tự động hủy chỗ.</p>
      </div>

      <a href="/parking"><button class="button"> Quay lại trang đặt chỗ </button></a>
    </div>
  </div>
</div>
<script src="js/confirm.js"></script>
<script>
  window.bookingCode = "{{bookingCode}}";
</script>